# Local production-build example. Analytics is never loaded by `npm run dev`.
PUBLIC_DEPLOY_ENV=production
PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_ANALYTICS_SITE_ID=00000000-0000-0000-0000-000000000000
PUBLIC_ANALYTICS_SCRIPT_URL=https://cloud.umami.is/script.js

# Public browser credentials for the homepage like button.
# Never put a Supabase secret or service-role key here.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
