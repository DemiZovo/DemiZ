name = "demiz-writer"
main = "src/index.js"
compatibility_date = "2026-08-14"

[vars]
GITHUB_REPOSITORY = "OWNER/REPOSITORY"
GITHUB_BRANCH = "main"
GITHUB_CLIENT_ID = "GITHUB_OAUTH_CLIENT_ID"
ALLOWED_GITHUB_USER_ID = "12345678"

[secrets]
required = ["GITHUB_CLIENT_SECRET", "GITHUB_TOKEN", "SESSION_SECRET"]

[ai]
binding = "AI"

[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = true

# 使用 `wrangler secret put` 配置，绝不要写进此文件：
# GITHUB_TOKEN
# GITHUB_CLIENT_SECRET
# SESSION_SECRET
