---
import { siteConfig } from '../config/site';
import { sitePath } from '../lib/urls';

const { pathname } = Astro.props;
type IconName = 'blog' | 'workshop' | 'collection' | 'life' | 'about';
type NavItem = { href: string; label: string; icon: IconName };

// 一级导航收敛为五个（品牌即首页）；Archive/Tags/RSS/Friends 下沉到 Footer，Guestbook 到 About。
const primaryLinks: NavItem[] = [
  { href: '/blog/', label: '魔法笔记', icon: 'blog' },
  { href: '/workshop/', label: '工作台', icon: 'workshop' },
  { href: '/collection/', label: '宝物柜', icon: 'collection' },
  { href: '/life/', label: '日常手账', icon: 'life' },
  { href: '/about/', label: '关于', icon: 'about' },
];

const current = (href: string) => href === '/' ? pathname === sitePath('/') : pathname.startsWith(sitePath(href));
---

<svg class="icon-sprite" aria-hidden="true">
  <symbol id="nav-blog" viewBox="0 0 24 24"><path d="M5 3h12a2 2 0 0 1 2 2v16H7a2 2 0 0 1-2-2zM8 7h8M8 11h8M8 15h5" /></symbol>
  <symbol id="nav-workshop" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></symbol>
  <symbol id="nav-collection" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></symbol>
  <symbol id="nav-life" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z" /></symbol>
  <symbol id="nav-about" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7h.01" /></symbol>
  <symbol id="nav-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></symbol>
  <symbol id="nav-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></symbol>
  <symbol id="nav-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></symbol>
</svg>

<header class="site-header">
  <a class="brand" href={sitePath('/')}>{siteConfig.name}</a>
  <nav class="primary-nav" aria-label="主导航">
    <ul>
      {primaryLinks.map(({ href, label, icon }) => (
        <li><a href={sitePath(href)} aria-current={current(href) ? 'page' : undefined}><svg aria-hidden="true"><use href={`#nav-${icon}`}></use></svg><span>{label}</span></a></li>
      ))}
    </ul>
  </nav>
  <div class="header-tools">
    <button class="tool-button theme-button" type="button" data-theme-toggle aria-label="切换到深色主题"><svg class="moon-icon" aria-hidden="true"><use href="#nav-moon"></use></svg><svg class="sun-icon" aria-hidden="true"><use href="#nav-sun"></use></svg></button>
    <a class="tool-button search-button" href={sitePath('/search/')} aria-label="搜索" aria-current={current('/search/') ? 'page' : undefined}><svg aria-hidden="true"><use href="#nav-search"></use></svg></a>
  </div>
</header>
