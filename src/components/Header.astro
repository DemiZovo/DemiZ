---
import { siteConfig } from '../config/site';
import { sitePath } from '../lib/urls';
const { pathname } = Astro.props;
const links: [string, string][] = [
  ['/', '首页'], ['/blog/', '技术博客'], ['/projects/', '代码项目'], ['/life/', '生活日志'],
  ['/archives/', '归档'], ['/tags/', '标签'], ['/about/', '关于我'], ['/search/', '搜索'],
];
const current = (href: string) => href === '/' ? pathname === sitePath('/') : pathname.startsWith(sitePath(href));
---
<header class="site-header">
  <a class="brand" href={sitePath('/')}>{siteConfig.name}</a>
  <nav aria-label="主导航"><ul>{links.map(([href, label]) => <li><a href={sitePath(href)} aria-current={current(href) ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
  <button class="icon-button" type="button" data-theme-toggle aria-label="切换主题">🌙</button>
</header>
