---
import { siteConfig } from '../config/site';
import { sitePath } from '../lib/urls';

const { pathname } = Astro.props;
type IconName = 'home' | 'blog' | 'projects' | 'life' | 'about' | 'archive' | 'category' | 'tag' | 'message' | 'write';
type NavItem = { href: string; label: string; icon: IconName };

const primaryLinks: NavItem[] = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/blog/', label: '博客', icon: 'blog' },
  { href: '/projects/', label: '项目', icon: 'projects' },
  { href: '/life/', label: '生活', icon: 'life' },
  { href: '/about/', label: '关于', icon: 'about' },
];
const secondaryLinks: NavItem[] = [
  { href: '/archives/', label: '归档', icon: 'archive' },
  { href: '/categories/', label: '分类', icon: 'category' },
  { href: '/tags/', label: '标签', icon: 'tag' },
  { href: '/guestbook/', label: '留言', icon: 'message' },
];
const current = (href: string) => href === '/' ? pathname === sitePath('/') : pathname.startsWith(sitePath(href));
const secondaryActive = secondaryLinks.some(({ href }) => current(href));
const writerUrl = import.meta.env.PUBLIC_WRITER_URL || (import.meta.env.DEV ? sitePath('/write/') : '');
---
<svg class="icon-sprite" aria-hidden="true">
  <symbol id="nav-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></symbol>
  <symbol id="nav-blog" viewBox="0 0 24 24"><path d="M5 3h12a2 2 0 0 1 2 2v16H7a2 2 0 0 1-2-2zM8 7h8M8 11h8M8 15h5" /></symbol>
  <symbol id="nav-projects" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></symbol>
  <symbol id="nav-life" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z" /></symbol>
  <symbol id="nav-about" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7h.01" /></symbol>
  <symbol id="nav-archive" viewBox="0 0 24 24"><path d="M4 7h16v13H4zM3 3h18v4H3zM9 11h6" /></symbol>
  <symbol id="nav-category" viewBox="0 0 24 24"><path d="M3 5h7l2 2h9v12H3z" /><path d="M7 11h10M7 15h7" /></symbol>
  <symbol id="nav-tag" viewBox="0 0 24 24"><path d="M20 13 13 20 4 11V4h7z" /><circle cx="8.5" cy="8.5" r="1" /></symbol>
  <symbol id="nav-message" viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" /></symbol>
  <symbol id="nav-write" viewBox="0 0 24 24"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" /></symbol>
  <symbol id="nav-more" viewBox="0 0 24 24"><path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/></symbol>
  <symbol id="nav-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></symbol>
  <symbol id="nav-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></symbol>
  <symbol id="nav-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></symbol>
</svg>

<header class="site-header">
  <a class="brand" href={sitePath('/')}>{siteConfig.name}</a>
  <nav class="primary-nav" aria-label="主导航">
    <ul>{primaryLinks.map(({ href, label, icon }) => <li><a href={sitePath(href)} aria-current={current(href) ? 'page' : undefined}><svg aria-hidden="true"><use href={`#nav-${icon}`}></use></svg><span>{label}</span></a></li>)}</ul>
  </nav>
  <div class="header-tools">
    <details class="more-menu" data-more-menu>
      <summary class="tool-button" aria-label="更多导航" aria-current={secondaryActive ? 'page' : undefined}><svg aria-hidden="true"><use href="#nav-more"></use></svg><span></span></summary>
      <ul class="more-menu-list">
        {secondaryLinks.map(({ href, label, icon }) => <li><a href={sitePath(href)} aria-current={current(href) ? 'page' : undefined}><svg aria-hidden="true"><use href={`#nav-${icon}`}></use></svg><span>{label}</span></a></li>)}
        {writerUrl && <li><a href={writerUrl}><svg aria-hidden="true"><use href="#nav-write"></use></svg><span>写作台</span></a></li>}
      </ul>
    </details>
    <span class="tool-divider" aria-hidden="true"></span>
    <button class="tool-button theme-button" type="button" data-theme-toggle aria-label="切换到深色主题"><svg class="moon-icon" aria-hidden="true"><use href="#nav-moon"></use></svg><svg class="sun-icon" aria-hidden="true"><use href="#nav-sun"></use></svg></button>
    <a class="tool-button search-button" href={sitePath('/search/')} aria-label="搜索" aria-current={current('/search/') ? 'page' : undefined}><svg aria-hidden="true"><use href="#nav-search"></use></svg></a>
  </div>
</header>

<script>
  const menu = document.querySelector('[data-more-menu]');
  if (menu instanceof HTMLDetailsElement) {
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
