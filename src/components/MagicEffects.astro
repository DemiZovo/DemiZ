---
const { isHome = false } = Astro.props;
---
<div class="magic-effects" aria-hidden="true" data-magic-effects>
  {Array.from({ length: 12 }, (_, index) => <i style={`--i:${index}`}></i>)}
</div>

{isHome && (
  <div class="seal-gate" data-seal-gate role="dialog" aria-modal="true" aria-labelledby="seal-title">
    <div class="seal-card">
      <span class="seal-star" aria-hidden="true">✦</span>
      <p class="eyebrow">DemiZ's Magic Archive</p>
      <h1 id="seal-title">封印解除</h1>
      <p>打开这本记录代码魔法与平凡日常的资料库。</p>
      <button type="button" class="seal-key" data-seal-key>
        <span aria-hidden="true">✧</span> 开启资料库
      </button>
    </div>
  </div>
)}

<div class="sparkle-layer" aria-hidden="true" data-sparkle-layer></div>

<script>
  const root = document.documentElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sparkleLayer = document.querySelector('[data-sparkle-layer]');
  const gate = document.querySelector('[data-seal-gate]');
  const readStorage = (storage: Storage, key: string) => {
    try { return storage.getItem(key); } catch { return null; }
  };
  const writeStorage = (storage: Storage, key: string, value: string) => {
    try { storage.setItem(key, value); } catch {}
  };

  const setEffects = (enabled: boolean) => {
    root.dataset.effects = enabled ? 'on' : 'off';
    document.querySelectorAll('[data-hero-seal-key]').forEach((button) => {
      button.setAttribute('aria-pressed', String(enabled));
      button.setAttribute('aria-label', enabled ? '封印魔法特效' : '解除封印并开启魔法特效');
      button.setAttribute('title', enabled ? '点击封印全部魔法特效' : '点击解除封印并开启魔法特效');
    });
  };

  let enabled = !reduceMotion && readStorage(localStorage, 'magic-effects') !== 'off';
  setEffects(enabled);

  if (gate && readStorage(sessionStorage, 'seal-opened') !== 'yes' && !reduceMotion) {
    root.classList.add('magic-ready');
  } else {
    gate?.remove();
  }

  const burstAt = (x: number, y: number) => {
    if (!enabled || reduceMotion || !(sparkleLayer instanceof HTMLElement)) return;
    for (let index = 0; index < 9; index += 1) {
      const burst = document.createElement('span');
      burst.className = 'click-spark magic-burst';
      burst.style.left = `${x}px`;
      burst.style.top = `${y}px`;
      burst.style.setProperty('--burst-angle', `${index * 40}deg`);
      sparkleLayer.append(burst);
      setTimeout(() => burst.remove(), 850);
    }
  };
  document.addEventListener('click', (event) => {
    const key = event.target instanceof Element ? event.target.closest('[data-seal-key], [data-hero-seal-key]') : null;
    if (!(key instanceof HTMLElement)) return;
    const box = key.getBoundingClientRect();
    if (key.hasAttribute('data-hero-seal-key')) {
      enabled = !enabled;
      setEffects(enabled);
      writeStorage(localStorage, 'magic-effects', enabled ? 'on' : 'off');
      if (enabled) burstAt(box.left + box.width / 2, box.top + box.height / 2);
      return;
    }
    burstAt(box.left + box.width / 2, box.top + box.height / 2);
    if (key.hasAttribute('data-seal-key')) {
      writeStorage(sessionStorage, 'seal-opened', 'yes');
      gate?.classList.add('is-opening');
      setTimeout(() => gate?.remove(), 700);
    }
  });

  let scrollFrame = 0;
  const updateParallax = () => {
    scrollFrame = 0;
    if (enabled && !reduceMotion) root.style.setProperty('--magic-scroll', `${Math.min(scrollY * .08, 72)}px`);
  };
  addEventListener('scroll', () => {
    if (!scrollFrame) scrollFrame = requestAnimationFrame(updateParallax);
  }, { passive: true });

  document.addEventListener('pointerdown', (event) => {
    if (!enabled || reduceMotion || !(sparkleLayer instanceof HTMLElement)) return;
    const burst = document.createElement('span');
    burst.className = 'click-spark';
    burst.style.left = `${event.clientX}px`;
    burst.style.top = `${event.clientY}px`;
    sparkleLayer.append(burst);
    setTimeout(() => burst.remove(), 650);
  });

  document.querySelectorAll('[data-article-content] pre').forEach((pre) => {
    if (!(pre instanceof HTMLElement) || pre.querySelector('[data-code-copy]')) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.dataset.codeCopy = '';
    button.innerHTML = '<span aria-hidden="true">✦</span><span>复制代码</span>';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.lastElementChild!.textContent = '已收进卡牌';
      } catch {
        button.lastElementChild!.textContent = '复制失败';
      }
      setTimeout(() => { if (button.lastElementChild) button.lastElementChild.textContent = '复制代码'; }, 1600);
    });
    pre.append(button);
  });
</script>
