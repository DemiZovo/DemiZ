---
import ArticleRow from './ArticleRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CategoryWithCount } from '../lib/categories';
import { getBlogByCategory } from '../lib/categories';
import { sitePath } from '../lib/urls';

interface Props {
  category: CategoryWithCount;
}

const { category } = Astro.props;
const entries = await getBlogByCategory(category.slug);
const tagCounts = new Map<string, number>();
for (const entry of entries) for (const tag of entry.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const topTags = [...tagCounts].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([tag]) => tag);
---
<BaseLayout title={`${category.name} | DemiZ`} description={category.description}>
  <section class="cat-head">
    <p><a href={sitePath('/blog/')}>← 魔法笔记</a></p>
    <p class="eyebrow">✦ {category.card}</p>
    <h1 class="cat-head__title">{category.name}</h1>
    <p class="cat-head__zh">{category.zh}</p>
    <p class="cat-head__desc">{category.description}</p>
    <p class="cat-head__count">{entries.length} note{entries.length === 1 ? '' : 's'}</p>
    {topTags.length > 0 && (
      <ul class="cat-head__tags">
        {topTags.map(tag => <li><a href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a></li>)}
      </ul>
    )}
  </section>

  {entries.length > 0 ? (
    <section class="article-list" aria-label={`${category.name} 的文章列表`}>
      {entries.map(entry => <ArticleRow entry={entry} />)}
    </section>
  ) : (
    <p class="empty">这里还没有留下记录。<br />魔法正在学习中。</p>
  )}
</BaseLayout>

<style>
  .cat-head{max-width:var(--container-reading);margin-inline:auto;padding-top:var(--space-6)}
  .cat-head>p:first-child a{color:var(--wine);text-decoration:none}
  .cat-head__title{font-size:clamp(2.4rem,6vw,3.4rem);font-weight:650;letter-spacing:-.03em;line-height:1.08;margin:.3rem 0 0}
  .cat-head__zh{color:var(--muted);margin:.3rem 0 0}
  .cat-head__desc{max-width:32rem;color:var(--muted);font-size:1.05rem;line-height:1.7}
  .cat-head__count{margin-top:var(--space-5);color:var(--muted);font-size:.9rem;font-variant-numeric:tabular-nums}
  .cat-head__tags{display:flex;flex-wrap:wrap;gap:var(--space-2);margin:var(--space-4) 0 0;padding:0;list-style:none}
  .cat-head__tags a{color:var(--muted);font-size:.88rem;text-decoration:none;border-bottom:1px solid var(--border-strong)}
  .cat-head__tags a:hover{color:var(--wine);border-bottom-color:var(--wine)}

  .article-list{max-width:var(--container-reading);margin:var(--space-7) auto 0}
  .empty{max-width:var(--container-reading);margin:var(--space-7) auto 0;padding:var(--space-7);text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:var(--radius-md)}
</style>
