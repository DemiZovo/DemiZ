---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLikeButton from '../components/HomeLikeButton.astro';
import MagicCompanion from '../components/MagicCompanion.astro';
import { entryPath, getPublicContent } from '../lib/content';
import { siteConfig } from '../config/site';
import { sitePath } from '../lib/urls';
const allEntries = await getPublicContent();
const featuredEntries = allEntries.filter(entry => entry.data.featured);
const entries = allEntries.slice(0, 6);
---
<BaseLayout>
  <section class="hero home-magic-hero">
    <div class="hero-magic-copy">
      <p class="eyebrow">
        <svg xmlns="http://www.w3.org/2000/svg"
          width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flower-icon lucide-flower" aria-hidden="true"><circle cx="12" cy="12" r="3"/>
          <path d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 1 1 4.5 4.5 4.5 4.5 0 1 1-4.5 4.5"/>
          <path d="M12 7.5V9"/><path d="M7.5 12H9"/>
          <path d="M16.5 12H15"/><path d="M12 16.5V15"/>
          <path d="m8 8 1.88 1.88"/><path d="M14.12 9.88 16 8"/>
          <path d="m8 16 1.88-1.88"/><path d="M14.12 14.12 16 16"/>
        </svg>
      </p>
      <h1 class="typed-slogan" aria-label="HELLO WORLD，以 coding 之名，开启探索世界的旅程">
        <span class="slogan-line slogan-line--hello">HELLO WORLD</span>
        <span class="slogan-line slogan-line--coding">以 <code>coding</code> 之名</span>
        <span class="slogan-line slogan-line--journey">开启探索世界的旅程</span>
      </h1>
      <p>我是 {siteConfig.name}，把技术学习、工程实践和日常灵感，收进自己的魔法库。</p>
      <div class="hero-links">
        <p><a href={siteConfig.author.github}>GitHub</a> · <a href={siteConfig.author.leetcode}>LeetCode</a> · <a href={sitePath('/blog/')}>翻开魔法笔记</a></p>
        <HomeLikeButton />
      </div>
    </div>
    <MagicCompanion />
  </section>
  {featuredEntries.length > 0 && (
    <section class="home-updates" aria-labelledby="featured">
      <p class="eyebrow">Featured</p>
      <h2 id="featured">精选文章</h2>
      <div class="grid">{featuredEntries.map(entry => <article class="card">
        <p class="meta">精选 · {entry.data.published.toLocaleDateString('zh-CN')}</p>
        <h3><a class="card-link" href={sitePath(entryPath(entry))}>{entry.data.title}</a></h3>
        <p>{entry.data.description}</p>
        <ul class="tags">{entry.data.tags.map(tag => <li><a class="tag" href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a></li>)}</ul>
      </article>)}</div>
    </section>
  )}
  <section class="home-updates" aria-labelledby="recent">
    <h2 id="recent">最近更新</h2>
    <div class="grid">{entries.map(entry => <article class="card">
      <p class="meta">{entry.data.published.toLocaleDateString('zh-CN')}</p>
      <h3><a class="card-link" href={sitePath(entryPath(entry))}>{entry.data.title}</a></h3>
      <p>{entry.data.description}</p>
      <ul class="tags">{entry.data.tags.map(tag => <li><a class="tag" href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a></li>)}</ul>
    </article>)}</div>
  </section>
</BaseLayout>
