---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {getPublicContent} from '../../lib/content'; import {sitePath} from '../../lib/urls'; const entries=await getPublicContent(); const counts=new Map<string,number>(); for(const e of entries)for(const tag of e.data.tags)counts.set(tag,(counts.get(tag)??0)+1);
---
<BaseLayout title="卡牌标签"><section class="hero"><p class="eyebrow">Card Index</p><h1>卡牌标签</h1><p>从关键词重新发现笔记与日常。</p></section><ul class="tags">{[...counts].sort((a,b)=>a[0].localeCompare(b[0],'zh-CN')).map(([tag,count])=><li><a class="tag" href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}>{tag}（{count}）</a></li>)}</ul></BaseLayout>
