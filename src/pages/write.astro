---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/sakura-theme.css';
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="description" content="DemiZ 的私有 Markdown 写作台" />
  <title>写作台 | DemiZ</title>
  <script is:inline>
    try {
      const saved = localStorage.getItem('theme');
      const theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    } catch {}
  </script>
</head>
<body>
  <main>
  <section class="writer" data-writer>
    <header class="writer__header">
      <div>
        <p class="eyebrow">Writer</p>
        <h1>写点什么</h1>
        <p class="muted">文章和图片会一起提交，构建通过后自动发布。</p>
      </div>
      <div class="writer__actions">
        <label class="writer-button writer-button--ghost">
          导入 MD 与图片
          <input type="file" accept=".md,.mdx,text/markdown,image/png,image/jpeg,image/webp,image/avif,image/gif,image/svg+xml" multiple data-import hidden />
        </label>
        <button class="writer-button writer-button--ghost" type="button" data-new-article>新建文章</button>
        <button class="writer-button writer-button--ghost" type="button" data-preview>预览</button>
        <button class="writer-button writer-button--ghost" type="button" data-download>下载 MD</button>
        <button class="writer-button writer-button--ghost" type="button" data-save-draft>保存草稿</button>
        <button class="writer-button writer-button--ghost" type="button" data-save-draft-copy>另存为新草稿</button>
        <button class="writer-button writer-button--ghost" type="button" data-drafts>草稿箱 <span class="writer-draft-count" data-draft-count>0</span></button>
        <a class="writer-button writer-button--ghost" href="/logout">退出</a>
        <button class="writer-button writer-button--publish" type="button" data-publish>发布</button>
      </div>
    </header>

    <form class="writer__grid" data-form>
      <div class="writer-card writer-card--editor">
        <div class="writer__title-row">
          <label><span>标题</span><input name="title" required maxlength="100" placeholder="文章标题" /></label>
          <label><span>Slug</span><input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="my-article" /></label>
        </div>
        <label class="writer__body"><span>Markdown 内容</span><textarea name="body" required placeholder="从这里开始写作……"></textarea></label>
      </div>

      <aside class="writer__sidebar">
        <fieldset class="writer-card writer__type">
          <legend>文章类型</legend>
          <label><input type="radio" name="collection" value="blog" checked /> 技术博客</label>
          <label><input type="radio" name="collection" value="life" /> 生活随笔</label>
        </fieldset>

        <fieldset class="writer-card writer__meta">
          <legend>元信息</legend>
          <label><span>摘要</span><textarea name="description" required maxlength="240" rows="3" placeholder="为这篇文章写一段简短摘要"></textarea></label>
          <label><span>标签</span><input name="tags" placeholder="Astro, TypeScript" /></label>
          <label data-blog-field><span>分类</span><input name="category" value="web" list="category-options" placeholder="ai-infra / web / engineering / dev" /><datalist id="category-options"><option value="ai-infra"></option><option value="web"></option><option value="engineering"></option><option value="dev"></option></datalist></label>
          <label><span>发布日期</span><input name="published" type="date" required /></label>
          <label><span>更新日期（可选）</span><input name="updated" type="date" /></label>
          <label class="writer-check"><input name="featured" type="checkbox" /> 设为精选</label>
          <label class="writer-check" data-blog-field><input name="toc" type="checkbox" checked /> 显示目录</label>
        </fieldset>

        <fieldset class="writer-card">
          <legend><span data-image-title>正文图片</span></legend>
          <label class="writer-dropzone writer-dropzone--small">
            <span>＋ 添加图片</span>
            <input type="file" accept="image/png,image/jpeg,image/webp,image/avif" multiple data-images hidden />
          </label>
          <ul class="writer-images" data-image-list></ul>
        </fieldset>
      </aside>
    </form>
    <p class="writer-status" role="status" aria-live="polite" data-status></p>
  </section>

  <dialog class="writer-dialog" data-dialog>
    <form method="dialog"><button aria-label="关闭预览">×</button></form>
    <article class="article" data-preview-output></article>
  </dialog>

  <dialog class="writer-dialog writer-dialog--drafts" data-drafts-dialog>
    <div class="writer-drafts__header">
      <div>
        <p class="eyebrow">Local drafts</p>
        <h2>草稿箱</h2>
        <p class="muted">草稿只保存在这个浏览器中，不会提交到 GitHub。</p>
      </div>
      <form method="dialog"><button aria-label="关闭草稿箱">×</button></form>
    </div>
    <p class="writer-drafts__empty" data-drafts-empty>还没有保存过草稿。</p>
    <ul class="writer-draft-list" data-draft-list></ul>
  </dialog>
  </main>

<script>
  type Collection = 'blog' | 'life';
  type ImageEntry = { file: File; alt: string; caption: string };
  type DraftRecord = {
    id: string;
    savedAt: string;
    collection: Collection;
    title: string;
    slug: string;
    body: string;
    description: string;
    tags: string;
    category: string;
    published: string;
    updated: string;
    featured: boolean;
    toc: boolean;
    images: ImageEntry[];
  };
  const root = document.querySelector<HTMLElement>('[data-writer]');
  const form = root?.querySelector<HTMLFormElement>('[data-form]') as HTMLFormElement;
  if (!root || !form) throw new Error('Writer UI is unavailable');

  const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector);
  const status = $('[data-status]') as HTMLElement;
  const imageInput = $('[data-images]') as HTMLInputElement;
  let images: ImageEntry[] = [];
  let currentDraftId: string | null = null;
  const today = new Date().toISOString().slice(0, 10);
  (form.elements.namedItem('published') as HTMLInputElement).value = today;
  const draftDatabase = new Promise<IDBDatabase>((resolve, reject) => {
    const request = indexedDB.open('demiz-writer', 1);
    request.onupgradeneeded = () => {
      if (!request.result.objectStoreNames.contains('drafts')) request.result.createObjectStore('drafts', { keyPath: 'id' });
    };
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });

  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[char]!));
  const yamlString = (value: string) => JSON.stringify(value.trim());
  const yamlValue = (value: string): string | boolean | string[] => {
    const trimmed = value.trim();
    if (trimmed === 'true' || trimmed === 'false') return trimmed === 'true';
    if (trimmed.startsWith('[') && trimmed.endsWith(']')) {
      return trimmed.slice(1, -1).split(',').map((item) => String(yamlValue(item))).filter(Boolean);
    }
    if ((trimmed.startsWith('"') && trimmed.endsWith('"')) || (trimmed.startsWith("'") && trimmed.endsWith("'"))) {
      if (trimmed.startsWith('"')) {
        try { return JSON.parse(trimmed); } catch {}
      }
      return trimmed.slice(1, -1).replace(/''/g, "'");
    }
    return trimmed.replace(/\s+#.*$/, '').trim();
  };
  function parseFrontmatter(source: string) {
    const result: Record<string, string | boolean | string[]> = {};
    let listKey = '';
    for (const rawLine of source.split(/\r?\n/)) {
      const listItem = rawLine.match(/^\s+-\s+(.+)$/);
      if (listItem && listKey) {
        const list = result[listKey];
        if (Array.isArray(list)) list.push(String(yamlValue(listItem[1] || '')));
        continue;
      }
      const entry = rawLine.match(/^([A-Za-z][\w-]*):(?:\s*(.*))?$/);
      if (!entry) { listKey = ''; continue; }
      const key = entry[1] || '';
      const value = entry[2] || '';
      if (!value.trim()) { result[key] = []; listKey = key; }
      else { result[key] = yamlValue(value); listKey = ''; }
    }
    return result;
  }
  const slugify = (value: string) => value.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/[\s_]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
  const collection = () => (new FormData(form).get('collection') as Collection) || 'blog';
  const assetRoot = () => `/images/${collection()}/${(form.elements.namedItem('slug') as HTMLInputElement).value.trim()}`;
  const safeName = (name: string, index: number) => {
    const extension = name.split('.').pop()?.toLowerCase().replace('jpeg', 'jpg') || 'webp';
    const stem = slugify(name.replace(/\.[^.]+$/, '')) || `image-${index + 1}`;
    return `${stem}.${extension}`;
  };
  const fileBasename = (path: string) => {
    const cleanPath = path.split(/[?#]/, 1)[0] || '';
    const basename = cleanPath.replace(/\\/g, '/').split('/').pop() || '';
    try { return decodeURIComponent(basename).toLowerCase(); } catch { return basename.toLowerCase(); }
  };

  function importReferencedImages(body: string, selectedFiles: File[]) {
    const candidates = selectedFiles.filter((file) => file.type.startsWith('image/') || /\.(?:avif|gif|jpe?g|png|svg|webp)$/i.test(file.name));
    const byName = new Map(candidates.map((file) => [file.name.toLowerCase(), file]));
    let imported = 0;
    let missing = 0;
    const rewritten = body.replace(/(!\[[^\]]*\]\(\s*)(?:<([^>]+)>|([^\s)]+))((?:\s+["'][^"']*["'])?\s*\))/g, (source, prefix, anglePath, plainPath, suffix) => {
      const imagePath = String(anglePath || plainPath || '');
      if (/^(?:(?!file:)[a-z][a-z\d+.-]*:|\/|#)/i.test(imagePath)) return source;
      const file = byName.get(fileBasename(imagePath));
      if (!file) { missing += 1; return source; }
      let index = images.findIndex((entry) => entry.file === file);
      if (index < 0) {
        images.push({ file, alt: '', caption: '' });
        index = images.length - 1;
        imported += 1;
      }
      return `${prefix}${assetRoot()}/${safeName(file.name, index)}${suffix}`;
    });
    return { body: rewritten, imported, missing };
  }

  async function draftRequest<T>(mode: IDBTransactionMode, operation: (store: IDBObjectStore) => IDBRequest<T>) {
    const database = await draftDatabase;
    return new Promise<T>((resolve, reject) => {
      const transaction = database.transaction('drafts', mode);
      const request = operation(transaction.objectStore('drafts'));
      let result: T;
      request.onsuccess = () => { result = request.result; };
      request.onerror = () => reject(request.error);
      transaction.oncomplete = () => resolve(result);
      transaction.onerror = () => reject(transaction.error);
      transaction.onabort = () => reject(transaction.error);
    });
  }

  const getDrafts = () => draftRequest<DraftRecord[]>('readonly', (store) => store.getAll());
  const putDraft = (draft: DraftRecord) => draftRequest<IDBValidKey>('readwrite', (store) => store.put(draft));
  const removeDraft = (id: string) => draftRequest<undefined>('readwrite', (store) => store.delete(id));
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

  function readDraft(id = currentDraftId || crypto.randomUUID()): DraftRecord {
    return {
      id,
      savedAt: new Date().toISOString(),
      collection: collection(),
      title: field('title').value,
      slug: field('slug').value,
      body: field('body').value,
      description: field('description').value,
      tags: field('tags').value,
      category: field('category').value,
      published: field('published').value,
      updated: field('updated').value,
      featured: (field('featured') as HTMLInputElement).checked,
      toc: (field('toc') as HTMLInputElement).checked,
      images: images.map((image) => ({ ...image })),
    };
  }

  function restoreDraft(draft: DraftRecord) {
    currentDraftId = draft.id;
    (form.elements.namedItem('collection') as RadioNodeList).value = draft.collection;
    field('title').value = draft.title;
    field('slug').value = draft.slug;
    field('body').value = draft.body;
    field('description').value = draft.description;
    field('tags').value = draft.tags;
    field('category').value = draft.category;
    field('published').value = draft.published || today;
    field('updated').value = draft.updated;
    (field('featured') as HTMLInputElement).checked = draft.featured;
    (field('toc') as HTMLInputElement).checked = draft.toc;
    const slug = field('slug') as HTMLInputElement;
    if (draft.slug) slug.dataset.edited = 'true'; else delete slug.dataset.edited;
    images = draft.images || [];
    form.dispatchEvent(new Event('change', { bubbles: true }));
    renderImages();
  }

  function hasEditorContent() {
    return images.length > 0 || ['title', 'slug', 'body', 'description', 'tags', 'updated'].some((name) => field(name).value.trim());
  }

  function startNewArticle() {
    if (hasEditorContent() && !confirm('新建文章会清空当前编辑器；已保存的草稿不会被删除。确定继续吗？')) return;
    form.reset();
    currentDraftId = null;
    images = [];
    renderImages();
    field('published').value = today;
    const slug = field('slug') as HTMLInputElement;
    delete slug.dataset.edited;
    form.dispatchEvent(new Event('change', { bubbles: true }));
    field('title').focus();
    form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    status.textContent = '已新建文章；草稿箱中的原草稿保持不变。';
  }

  async function saveBrowserDraft(button: HTMLButtonElement, asCopy = false) {
    button.disabled = true;
    try {
      const draft = readDraft(asCopy ? crypto.randomUUID() : undefined);
      await putDraft(draft);
      currentDraftId = draft.id;
      await updateDraftCount();
      status.textContent = `${asCopy ? '已另存为新草稿' : '草稿已保存到当前浏览器'}：${draft.title.trim() || '未命名草稿'}`;
    } catch {
      status.textContent = '草稿保存失败，请检查浏览器存储空间或隐私设置。';
    } finally {
      button.disabled = false;
    }
  }

  async function updateDraftCount() {
    const drafts = await getDrafts();
    ($('[data-draft-count]') as HTMLElement).textContent = String(drafts.length);
    return drafts;
  }

  async function renderDrafts() {
    const drafts = (await updateDraftCount()).sort((left, right) => right.savedAt.localeCompare(left.savedAt));
    const list = document.querySelector('[data-draft-list]') as HTMLUListElement;
    const empty = document.querySelector('[data-drafts-empty]') as HTMLElement;
    empty.hidden = drafts.length > 0;
    list.replaceChildren(...drafts.map((draft) => {
      const item = document.createElement('li');
      item.className = 'writer-draft-item';
      const summary = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = draft.title.trim() || '未命名草稿';
      const meta = document.createElement('span');
      const savedAt = new Date(draft.savedAt).toLocaleString('zh-CN', { dateStyle: 'medium', timeStyle: 'short' });
      meta.textContent = `${draft.collection === 'blog' ? '技术博客' : '生活随笔'} · ${savedAt}`;
      summary.append(title, meta);
      const actions = document.createElement('div');
      const restore = document.createElement('button');
      restore.type = 'button';
      restore.textContent = '继续写';
      restore.addEventListener('click', () => {
        restoreDraft(draft);
        (document.querySelector('[data-drafts-dialog]') as HTMLDialogElement).close();
        status.textContent = `已恢复草稿：${draft.title.trim() || '未命名草稿'}`;
      });
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'writer-draft-item__delete';
      remove.textContent = '删除';
      remove.addEventListener('click', async () => {
        if (!confirm(`确定删除草稿“${draft.title.trim() || '未命名草稿'}”吗？`)) return;
        await removeDraft(draft.id);
        if (currentDraftId === draft.id) currentDraftId = null;
        await renderDrafts();
      });
      actions.append(restore, remove);
      item.append(summary, actions);
      return item;
    }));
  }

  function buildMarkdown() {
    const data = new FormData(form);
    const kind = collection();
    const slug = String(data.get('slug') || '').trim();
    const tags = String(data.get('tags') || '').split(',').map((tag) => tag.trim()).filter(Boolean);
    const lines = ['---', `title: ${yamlString(String(data.get('title') || ''))}`, `description: ${yamlString(String(data.get('description') || ''))}`, `slug: ${yamlString(slug)}`, `published: ${data.get('published')}`];
    if (data.get('updated')) lines.push(`updated: ${data.get('updated')}`);
    if (kind === 'blog') lines.push(`category: ${yamlString(String(data.get('category') || '未分类'))}`);
    lines.push(`tags: [${tags.map(yamlString).join(', ')}]`);
    if (kind === 'life') {
      if (!images.length) lines.push('gallery: []');
      else lines.push('gallery:');
      images.forEach((image, index) => {
        lines.push(`  - src: ${assetRoot()}/${safeName(image.file.name, index)}`);
        lines.push(`    alt: ${yamlString(image.alt || `生活记录图片 ${index + 1}`)}`);
        if (image.caption) lines.push(`    caption: ${yamlString(image.caption)}`);
      });
    }
    lines.push('draft: false', `featured: ${data.has('featured')}`);
    if (kind === 'blog') lines.push(`toc: ${data.has('toc')}`);
    return `${lines.join('\n')}\n---\n\n${String(data.get('body') || '').trim()}\n`;
  }

  function renderImages() {
    const list = $('[data-image-list]') as HTMLUListElement;
    list.replaceChildren(...images.map((entry, index) => {
      const item = document.createElement('li');
      item.innerHTML = `<span>${escapeHtml(entry.file.name)}</span><input aria-label="图片替代文字" placeholder="图片说明" value="${escapeHtml(entry.alt)}"><button type="button" aria-label="移除图片">×</button>`;
      item.querySelector('input')?.addEventListener('input', (event) => entry.alt = (event.target as HTMLInputElement).value);
      item.querySelector('button')?.addEventListener('click', () => { images.splice(index, 1); renderImages(); });
      return item;
    }));
  }

  form.addEventListener('change', (event) => {
    if ((event.target as HTMLInputElement).name !== 'collection') return;
    const isBlog = collection() === 'blog';
    root.querySelectorAll<HTMLElement>('[data-blog-field]').forEach((field) => field.hidden = !isBlog);
    ($('[data-image-title]') as HTMLElement).textContent = isBlog ? '正文图片' : '相册图片';
  });
  (form.elements.namedItem('title') as HTMLInputElement).addEventListener('input', (event) => {
    const slug = form.elements.namedItem('slug') as HTMLInputElement;
    if (!slug.dataset.edited) slug.value = slugify((event.target as HTMLInputElement).value);
  });
  (form.elements.namedItem('slug') as HTMLInputElement).addEventListener('input', (event) => (event.target as HTMLInputElement).dataset.edited = 'true');
  imageInput.addEventListener('change', () => { images.push(...Array.from(imageInput.files || []).map((file) => ({ file, alt: '', caption: '' }))); renderImages(); imageInput.value = ''; });

  $('[data-new-article]')?.addEventListener('click', startNewArticle);
  $('[data-save-draft]')?.addEventListener('click', () => saveBrowserDraft($('[data-save-draft]') as HTMLButtonElement));
  $('[data-save-draft-copy]')?.addEventListener('click', () => saveBrowserDraft($('[data-save-draft-copy]') as HTMLButtonElement, true));

  $('[data-drafts]')?.addEventListener('click', async () => {
    try {
      await renderDrafts();
      (document.querySelector('[data-drafts-dialog]') as HTMLDialogElement).showModal();
    } catch {
      status.textContent = '草稿箱暂时不可用，请检查浏览器隐私设置。';
    }
  });

  $('[data-download]')?.addEventListener('click', () => {
    if (!form.reportValidity()) return;
    const blob = new Blob([buildMarkdown()], { type: 'text/markdown;charset=utf-8' });
    const link = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: `${(form.elements.namedItem('slug') as HTMLInputElement).value}.md` });
    link.click(); URL.revokeObjectURL(link.href);
  });
  $('[data-import]')?.addEventListener('change', async (event) => {
    const input = event.target as HTMLInputElement;
    const selectedFiles = Array.from(input.files || []);
    const file = selectedFiles.find((item) => /\.(?:md|mdx)$/i.test(item.name) || /^(?:text\/markdown|text\/x-markdown)$/.test(item.type));
    if (!file) {
      status.textContent = '请同时选择一个 MD 文件；可一并选中它引用的图片。';
      input.value = '';
      return;
    }
    const source = await file.text();
    const match = source.replace(/^\uFEFF/, '').match(/^---[ \t]*\r?\n([\s\S]*?)\r?\n---[ \t]*(?:\r?\n|$)([\s\S]*)$/);
    const rawBody = match ? (match[2] || '').trim() : source.trim();
    if (!match) {
      const importedImages = importReferencedImages(rawBody, selectedFiles);
      field('body').value = importedImages.body;
      renderImages();
      status.textContent = `正文已导入，未发现 frontmatter；已匹配 ${importedImages.imported} 张图片${importedImages.missing ? `，${importedImages.missing} 处本地图片引用未找到对应文件` : ''}。`;
      input.value = '';
      return;
    }
    const metadata = parseFrontmatter(match[1] || '');
    for (const name of ['title', 'description', 'slug', 'published', 'updated', 'category']) {
      if (metadata[name] !== undefined) field(name).value = String(metadata[name]);
    }
    if (Array.isArray(metadata.tags)) field('tags').value = metadata.tags.join(', ');
    else if (metadata.tags !== undefined) field('tags').value = String(metadata.tags);
    for (const name of ['featured', 'toc']) {
      if (typeof metadata[name] === 'boolean') (field(name) as HTMLInputElement).checked = metadata[name] as boolean;
    }
    const importedCollection: Collection = metadata.gallery !== undefined && metadata.category === undefined ? 'life' : 'blog';
    (form.elements.namedItem('collection') as RadioNodeList).value = importedCollection;
    const slug = field('slug') as HTMLInputElement;
    if (slug.value) slug.dataset.edited = 'true';
    form.dispatchEvent(new Event('change', { bubbles: true }));
    const importedImages = importReferencedImages(rawBody, selectedFiles);
    field('body').value = importedImages.body;
    renderImages();
    status.textContent = `正文和 frontmatter 已导入，已匹配 ${importedImages.imported} 张图片${importedImages.missing ? `；${importedImages.missing} 处本地图片引用未找到对应文件` : ''}。`;
    input.value = '';
  });
  $('[data-preview]')?.addEventListener('click', () => {
    const body = String(new FormData(form).get('body') || '');
    const output = document.querySelector<HTMLElement>('[data-preview-output]')!;
    output.innerHTML = body.split(/\n{2,}/).map((block) => {
      const heading = block.match(/^(#{1,4})\s+(.+)$/);
      if (heading) {
        const level = (heading[1] || '#').length;
        return `<h${level}>${escapeHtml(heading[2] || '')}</h${level}>`;
      }
      if (block.startsWith('```')) return `<pre><code>${escapeHtml(block.replace(/^```[^\n]*\n?|```$/g, ''))}</code></pre>`;
      return `<p>${escapeHtml(block).replace(/\n/g, '<br>')}</p>`;
    }).join('');
    (document.querySelector('[data-dialog]') as HTMLDialogElement).showModal();
  });

  const toBase64 = (file: File) => new Promise<string>((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(String(reader.result).split(',')[1] || ''); reader.onerror = reject; reader.readAsDataURL(file);
  });
  $('[data-publish]')?.addEventListener('click', async () => {
    if (!form.reportValidity()) return;
    if (/!\[[^\]]*\]\(\s*<?file:\/{2,}/i.test(field('body').value)) {
      status.textContent = '正文仍包含本机 file:/// 图片路径。请重新“导入 MD 与图片”并同时选中对应图片，或删除该引用后再发布。';
      return;
    }
    const button = $('[data-publish]') as HTMLButtonElement;
    button.disabled = true; status.textContent = '正在提交文章与图片……';
    try {
      const slug = (form.elements.namedItem('slug') as HTMLInputElement).value;
      const kind = collection();
      const files = [] as Array<{ path: string; content: string }>;
      for (const [index, image] of images.entries()) files.push({ path: `public/images/${kind}/${slug}/${safeName(image.file.name, index)}`, content: await toBase64(image.file) });
      const response = await fetch('/api/publish', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ collection: kind, slug, markdown: buildMarkdown(), files }) });
      if (response.status === 401) { location.href = '/login'; return; }
      const result = await response.json() as { message?: string; commitUrl?: string };
      if (!response.ok) throw new Error(result.message || '发布失败');
      if (currentDraftId) {
        try {
          await removeDraft(currentDraftId);
          currentDraftId = null;
          await updateDraftCount();
        } catch {}
      }
      status.innerHTML = result.commitUrl ? `已提交：<a href="${escapeHtml(result.commitUrl)}" target="_blank" rel="noreferrer">查看提交</a>` : '文章已提交。';
    } catch (error) { status.textContent = error instanceof Error ? error.message : '发布失败，请稍后重试。'; }
    finally { button.disabled = false; }
  });
  void updateDraftCount().catch(() => {});
</script>

<style>
  .writer{position:relative;margin-inline:calc(50% - 50vw);padding:clamp(1rem,3vw,2.5rem) max(1rem,calc((100vw - 92rem)/2));background:radial-gradient(circle at 12% 85%,rgba(89,221,214,.28),transparent 31%),radial-gradient(circle at 89% 79%,rgba(255,226,73,.28),transparent 34%);min-height:75vh}.writer__header{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1.25rem}.writer__header h1{margin:0;line-height:1.1}.writer__header p{margin:.2rem 0}.writer__actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.5rem}.writer-button{display:inline-flex;align-items:center;justify-content:center;min-height:2.75rem;padding:.55rem .9rem;border:1px solid var(--accent);border-radius:.75rem;background:var(--accent);color:white;cursor:pointer}.writer-button--ghost{border-color:var(--border);background:var(--surface);color:var(--text)}.writer-button--publish{background:#198f7c;border-color:#198f7c}.writer-button:disabled{cursor:wait;opacity:.6}.writer-draft-count{display:inline-grid;place-items:center;min-width:1.35rem;height:1.35rem;margin-left:.35rem;padding:0 .25rem;border-radius:999px;background:color-mix(in srgb,var(--accent) 14%,transparent);font-size:.75rem;font-weight:700}.writer__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(17rem,22rem);align-items:start;gap:1rem}.writer-card{min-width:0;padding:1rem;border:1px solid rgba(255,255,255,.7);border-radius:1.4rem;background:color-mix(in srgb,var(--surface) 80%,transparent);box-shadow:var(--shadow);backdrop-filter:blur(18px)}fieldset.writer-card{margin:0}.writer-card legend{padding:0 .35rem;color:var(--muted);font-weight:700}.writer-card--editor{display:flex;flex-direction:column;min-height:65rem}.writer__title-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(10rem,.35fr);gap:.75rem}.writer label>span{display:block;margin-bottom:.25rem;color:var(--muted);font-size:.85rem}.writer input:not([type=radio]):not([type=checkbox]),.writer textarea{width:100%;padding:.7rem .8rem;border:1px solid var(--border);border-radius:.7rem;background:color-mix(in srgb,var(--surface) 82%,transparent);color:var(--text)}.writer__body{display:flex;flex:1;flex-direction:column;margin-top:.75rem}.writer__body textarea{flex:1;min-height:35rem;resize:vertical;font-family:"Cascadia Code",Consolas,monospace;line-height:1.7}.writer__sidebar{display:grid;gap:1rem}.writer__type{display:flex;gap:1rem}.writer__type label,.writer-check{display:flex!important;align-items:center;gap:.45rem}.writer__meta{display:grid;gap:.7rem}.writer-dropzone{display:grid;place-items:center;min-height:10rem;border:1px dashed var(--border);border-radius:1rem;color:var(--muted);cursor:pointer;text-align:center}.writer-dropzone--small{min-height:5rem}.writer-images{display:grid;gap:.5rem;margin:.75rem 0 0;padding:0;list-style:none}.writer-images li{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;align-items:center;gap:.4rem;font-size:.8rem}.writer-images li span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.writer-images button{border:0;background:transparent;color:var(--muted);cursor:pointer}.writer-status{min-height:1.75rem;margin:1rem 0 0;text-align:center}.writer-dialog{width:min(52rem,calc(100% - 2rem));max-height:90vh;padding:1rem;border:1px solid var(--border);border-radius:1rem;background:var(--bg);color:var(--text)}.writer-dialog::backdrop{background:rgba(10,12,18,.55);backdrop-filter:blur(4px)}.writer-dialog>form{display:flex;justify-content:flex-end}.writer-dialog>form button,.writer-drafts__header form button{border:0;background:transparent;color:var(--text);font-size:2rem;cursor:pointer}.writer-dialog .article{box-shadow:none}.writer-dialog--drafts{width:min(46rem,calc(100% - 2rem))}.writer-drafts__header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.writer-drafts__header h2{margin:.1rem 0}.writer-drafts__header p{margin:.2rem 0}.writer-draft-list{display:grid;gap:.65rem;margin:1.25rem 0 0;padding:0;list-style:none}.writer-draft-item{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem 1rem;border:1px solid var(--border);border-radius:.9rem;background:var(--surface)}.writer-draft-item>div:first-child{display:grid;min-width:0;gap:.2rem}.writer-draft-item strong,.writer-draft-item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.writer-draft-item span{color:var(--muted);font-size:.8rem}.writer-draft-item>div:last-child{display:flex;gap:.4rem}.writer-draft-item button{min-height:2.35rem;padding:.4rem .7rem;border:1px solid var(--border);border-radius:.65rem;background:var(--bg);color:var(--text);cursor:pointer}.writer-draft-item .writer-draft-item__delete{color:#b64747}.writer-drafts__empty{padding:2rem;text-align:center;color:var(--muted)}@media(max-width:900px){.writer__header{align-items:flex-start;flex-direction:column}.writer__actions{justify-content:flex-start}.writer__grid{grid-template-columns:1fr}.writer-card--editor{min-height:45rem}.writer__sidebar{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.writer{margin-inline:calc(50% - 50vw);padding-inline:.75rem}.writer__actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%}.writer__title-row,.writer__sidebar{grid-template-columns:1fr}.writer-card--editor{min-height:38rem}.writer-images li{grid-template-columns:1fr auto}.writer-images input{grid-column:1/-1;grid-row:2}.writer-draft-item{align-items:flex-start;flex-direction:column}.writer-draft-item>div:last-child{width:100%}.writer-draft-item button{flex:1}}
</style>
</body>
