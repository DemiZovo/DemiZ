---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';
const projects = await getProjects();
---
<BaseLayout title="代码项目">
  <section class="hero"><p class="eyebrow">Projects</p><h1>代码项目</h1><p>这里将展示值得单独介绍的 GitHub 仓库。</p></section>
  {projects.length > 0 ? <div class="grid">{projects.map(project => <article class="card">
    <h2>{project.name}</h2><p>{project.description}</p>
    <ul class="tags">{project.tags.map(tag => <li><span class="tag">{tag}</span></li>)}</ul>
    <p><a href={project.github?.url ?? `https://github.com/${project.repo}`}>查看 GitHub</a>{project.homepage && <> · <a href={project.homepage}>项目网站</a></>}</p>
    <p class="meta">{project.github ? `${project.github.stars} stars · ${project.github.language ?? '多语言'}` : 'GitHub 数据暂不可用'}</p>
  </article>)}</div> : <p class="empty">暂时没有公开展示的项目。你仍可以访问 <a href="https://github.com/DemiZovo">DemiZ 的 GitHub 主页</a>。</p>}
</BaseLayout>
