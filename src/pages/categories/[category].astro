---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryPath, getPublicBlog, type BlogEntry } from '../../lib/content';
import { sitePath } from '../../lib/urls';

export async function getStaticPaths() {
  const entries = await getPublicBlog();
  const categories = [...new Set(entries.map(entry => entry.data.category))];

  return categories.map(category => ({
    params: { category },
    props: {
      category,
      entries: entries.filter(entry => entry.data.category === category),
    },
  }));
}

interface Props {
  category: string;
  entries: BlogEntry[];
}

const { category, entries } = Astro.props;
---
<BaseLayout title={`分类：${category}`}>
  <section class="hero">
    <p class="eyebrow">Category</p>
    <h1>分类：{category}</h1>
    <p>共 {entries.length} 篇文章。</p>
  </section>
  <ul class="list-clean archive-list">
    {entries.map(entry => (
      <li>
        <time datetime={entry.data.published.toISOString()}>{entry.data.published.toLocaleDateString('zh-CN')}</time>
        <a href={sitePath(entryPath(entry))}>{entry.data.title}</a>
        <span class="read-badge" data-read-marker={`blog:${entry.data.slug}`} hidden>✓ 已读</span>
      </li>
    ))}
  </ul>
</BaseLayout>
