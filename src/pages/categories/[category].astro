---
// 旧分类名 → 新 slug 的迁移映射（v2 重构前的历史 URL）
// @ts-nocheck —— 纯重定向桩：sitePath/target 仅在顶层 return 中使用，astro check 会误报 ts(6133)
import { getBlogCategories, legacyCategoryAliases } from '../../lib/categories';
import { sitePath } from '../../lib/urls';

export async function getStaticPaths() {
  const categories = await getBlogCategories();
  const newSlugs = categories.map((category) => ({ params: { category: category.slug } }));
  const legacySlugs = Object.keys(legacyCategoryAliases).map((legacy) => ({ params: { category: legacy } }));
  return [...newSlugs, ...legacySlugs];
}

const { category } = Astro.params;
const target = legacyCategoryAliases[category as string] ?? category;
return Astro.redirect(sitePath(`/blog/${target}/`), 301);
---
