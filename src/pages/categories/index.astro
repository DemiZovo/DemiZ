---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicBlog } from '../../lib/content';
import { sitePath } from '../../lib/urls';

const entries = await getPublicBlog();
const counts = new Map<string, number>();

for (const entry of entries) {
  const category = entry.data.category;
  counts.set(category, (counts.get(category) ?? 0) + 1);
}
---
<BaseLayout title="魔法属性">
  <section class="hero">
    <p class="eyebrow">Magic Elements</p>
    <h1>魔法属性</h1>
    <p>按知识领域浏览已经记录的代码魔法。</p>
  </section>
  <ul class="tags">
    {[...counts]
      .sort((a, b) => a[0].localeCompare(b[0], 'zh-CN'))
      .map(([category, count]) => (
        <li><a class="tag" href={sitePath(`/categories/${encodeURIComponent(category)}/`)}>{category}（{count}）</a></li>
      ))}
  </ul>
</BaseLayout>
