---
import BlogArticle from '../../components/BlogArticle.astro';
import BlogCategory from '../../components/BlogCategory.astro';
import { getPublicBlog, type BlogEntry } from '../../lib/content';
import { getBlogCategories, type CategoryWithCount } from '../../lib/categories';

export async function getStaticPaths() {
  const entries = await getPublicBlog();
  const categories = await getBlogCategories();

  const articlePaths = entries.map((entry, index) => ({
    params: { slug: entry.data.slug },
    props: {
      kind: 'article' as const,
      entry,
      previous: entries[index - 1] ?? null,
      next: entries[index + 1] ?? null,
    },
  }));

  const categoryPaths = categories.map((category) => ({
    params: { slug: category.slug },
    props: { kind: 'category' as const, category },
  }));

  return [...articlePaths, ...categoryPaths];
}

interface Props {
  kind: 'article' | 'category';
  entry?: BlogEntry;
  previous?: BlogEntry | null;
  next?: BlogEntry | null;
  category?: CategoryWithCount;
}

const { kind, entry, previous, next, category } = Astro.props;
---

{kind === 'article' && entry
  ? <BlogArticle entry={entry} previous={previous ?? null} next={next ?? null} />
  : category
    ? <BlogCategory category={category} />
    : null}
