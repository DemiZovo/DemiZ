---
import { render } from 'astro:content';
import ArticleNavigation from '../../components/ArticleNavigation.astro';
import ArticleReaderTools from '../../components/ArticleReaderTools.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicBlog } from '../../lib/content';
import { sitePath } from '../../lib/urls';

export async function getStaticPaths() {
  const entries = await getPublicBlog();
  return entries.map((entry, index) => ({
    params: { slug: entry.data.slug },
    props: { entry, previous: entries[index - 1], next: entries[index + 1] },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---
<BaseLayout title={`${entry.data.title} | 技术博客`} description={entry.data.description} image={entry.data.cover} type="article" publishedTime={entry.data.published} updatedTime={entry.data.updated} tags={entry.data.tags}>
  <div class="article-layout">
    <article class="article" data-article-content>
      <p><a href={sitePath('/blog/')}>← 返回技术博客</a></p>
      <header class="article-hero article-hero--blog"><p class="meta">{entry.data.published.toLocaleDateString('zh-CN')} · <a href={sitePath(`/categories/${encodeURIComponent(entry.data.category)}/`)}>{entry.data.category}</a></p><h1>{entry.data.title}</h1><p>{entry.data.description}</p></header>
      <Content />
      <ArticleNavigation
        previous={previous && { title: previous.data.title, path: `/blog/${previous.data.slug}/` }}
        next={next && { title: next.data.title, path: `/blog/${next.data.slug}/` }}
        indexPath="/blog/"
        indexLabel="返回技术博客"
      />
    </article>
    <ArticleReaderTools entryKey={`blog:${entry.data.slug}`} headings={headings} showToc={entry.data.toc} />
  </div>
</BaseLayout>
